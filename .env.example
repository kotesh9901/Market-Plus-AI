# ============================================================
# MARKET PLUS AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to .env and update the values as required.
# Never commit real credentials or production secrets to Git.
# ============================================================

# ------------------------------------------------------------
# APPLICATION SECURITY
# ------------------------------------------------------------

# Generate a strong, unique secret before deployment.
# Example generation command:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-secret

# Flask debug mode: keep false outside local development.
FLASK_DEBUG=false

# ------------------------------------------------------------
# LOCAL DEVELOPMENT SERVER
# ------------------------------------------------------------

HOST=127.0.0.1
PORT=5000

# Set true only when the application is served through
# correctly configured HTTPS.
SESSION_COOKIE_SECURE=false

# ------------------------------------------------------------
# MARKET DATA
# ------------------------------------------------------------

# Default provider supported by the current config.py.
STOCK_PROVIDER=yfinance

# Market data cache duration in seconds.
STOCK_CACHE_SECONDS=60

# Historical data cache duration in seconds.
HISTORY_CACHE_SECONDS=86400

# Minimum historical rows required by configured workflows.
MINIMUM_HISTORY_ROWS=120

# ------------------------------------------------------------
# NEWS AND SENTIMENT
# ------------------------------------------------------------

# Provider-specific key, if required.
# Leave empty when no API key is configured.
NEWS_API_KEY=

# The current config.py defaults this to "none".
# Change only to a provider supported by your implementation.
NEWS_PROVIDER=none

# ------------------------------------------------------------
# EMAIL NOTIFICATIONS
# ------------------------------------------------------------

# SMTP server configuration.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true

# Enter credentials only in your private local .env file.
MAIL_USERNAME=
MAIL_APP_PASSWORD=

# Optional sender address.
# If empty, config.py falls back to MAIL_USERNAME.
MAIL_DEFAULT_SENDER=

# ------------------------------------------------------------
# ALERT PROCESSING
# ------------------------------------------------------------

# Minimum configured interval is 30 seconds.
ALERT_CHECK_INTERVAL_SECONDS=30


# ============================================================
# END OF TEMPLATE
# ============================================================